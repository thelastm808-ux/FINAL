<Window x:Class="Bluey.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Bluey · Windows host" Width="1000" Height="740" MinWidth="880" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#FF0E0E14" Foreground="#FFF4F1FA" FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="B L U E Y" FontSize="12" FontWeight="Bold" Foreground="#FF8DA9FF"/>
        <TextBlock Text="Your blueberry, now on Windows" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/>
        <TextBlock Text="Windows 11 desktop host · Android companion · OpenAI Realtime" FontSize="13" Foreground="#FF9894A8" Margin="0,5,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#FF181821" BorderBrush="#FF30303C" BorderThickness="1" CornerRadius="13" Padding="14,10" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FFF0BC66" Margin="0,0,8,0"/>
          <TextBlock x:Name="ConnectionStateText" Text="Starting host…" VerticalAlignment="Center" FontSize="12"/>
        </StackPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <Border Background="#FF181821" BorderBrush="#FF2D2D3A" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="01  ·  Connect your phone" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="Keep both devices on the same Wi-Fi. Bluey answers discovery requests on UDP 42425 and keeps the phone link on TCP 42424." Foreground="#FFAAA7B7" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,16"/>
            <TextBlock Text="HOST ADDRESS" Foreground="#FF858194" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
            <DockPanel>
              <TextBox x:Name="HostAddressText" IsReadOnly="True" FontFamily="Consolas" FontSize="13" BorderThickness="0" Background="#FF101017"/>
              <Button Content="Copy IP" Margin="8,0,0,0" Padding="12,6" Click="CopyIp_Click"/>
            </DockPanel>
            <TextBlock Text="PAIRING CODE · enter this on Android" Foreground="#FF858194" FontSize="10" FontWeight="Bold" Margin="0,12,0,6"/>
            <Border Background="#FF101017" BorderBrush="#FF30303C" BorderThickness="1" CornerRadius="9" Padding="12,9">
              <TextBlock x:Name="PairingCodeText" Text="------" FontFamily="Consolas" FontSize="21" FontWeight="SemiBold" Foreground="#FFB9CBFF"/>
            </Border>
            <TextBlock x:Name="PhoneStatusText" Text="No phone connected yet." Foreground="#FF9894A8" FontSize="12" Margin="0,12,0,0"/>
            <WrapPanel Margin="0,16,0,0">
              <Button Content="Wake phone" Background="#FF526FD0" BorderBrush="#FF6B86E8" Click="Wake_Click" Margin="0,0,8,8"/>
              <Button Content="Put to sleep" Click="Sleep_Click" Margin="0,0,8,8"/>
              <Button Content="Open meeting notes" Click="OpenNotes_Click" Margin="0,0,0,8"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Background="#FF181821" BorderBrush="#FF2D2D3A" BorderThickness="1" CornerRadius="18" Padding="20">
          <StackPanel>
            <TextBlock Text="02  ·  OpenAI key" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="The real API key stays in Windows Credential Manager. The Android app gets a short-lived token from this PC." Foreground="#FFAAA7B7" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,13"/>
            <PasswordBox x:Name="ApiKeyBox" Height="36" FontSize="13"/>
            <DockPanel Margin="0,10,0,0">
              <TextBlock x:Name="ApiKeyStatusText" Text="Checking saved key…" FontSize="12" Foreground="#FF9894A8" VerticalAlignment="Center"/>
              <Button Content="Save key" DockPanel.Dock="Right" Background="#FF526FD0" BorderBrush="#FF6B86E8" Click="SaveKey_Click"/>
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <Border Background="#FF181821" BorderBrush="#FF2D2D3A" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="03  ·  Desktop control" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="When enabled, Bluey can click, type, use shortcuts, scroll, drag, and open apps or websites when you ask." Foreground="#FFAAA7B7" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,10"/>
            <CheckBox x:Name="ComputerControlCheck" Content="Let Bluey use this computer" IsChecked="False" Foreground="#FFE2E0EA" FontSize="13" Checked="ComputerControlCheck_Changed" Unchecked="ComputerControlCheck_Changed"/>
            <TextBlock Text="For safety, it won't type into password fields or run lock / force-close shortcuts. Confirm important actions in the conversation first." Foreground="#FF8F8B9E" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,14"/>
            <WrapPanel>
              <Button x:Name="StopActionsButton" Content="Stop computer actions" Background="#FF4A242B" BorderBrush="#FF733541" Click="StopActions_Click" Margin="0,0,8,8"/>
              <Button x:Name="ResumeActionsButton" Content="Resume actions" IsEnabled="False" Click="ResumeActions_Click" Margin="0,0,0,8"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Background="#FF181821" BorderBrush="#FF2D2D3A" BorderThickness="1" CornerRadius="18" Padding="20" Height="260">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock Text="04  ·  Latest caption / report" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Live captions appear here while the phone is awake." FontSize="11" Foreground="#FF8F8B9E" Margin="0,5,0,0"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="CaptionLog" Text="Bluey is ready. Add your OpenAI key, then connect the Android app." TextWrapping="Wrap" Foreground="#FFD8D5E2" FontSize="12" LineHeight="19"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="2" Text="LOCAL NETWORK ONLY · Windows controls are executed on this PC · Keep the API key private" Foreground="#FF777486" FontSize="10" Margin="2,18,0,0"/>
  </Grid>
</Window>
